PORT=5001
NODE_ENV=development

# Database & Persistence
MONGODB_URI=mongodb://localhost:27017/email_scheduler

# Redis & Queue Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Ethereal SMTP Settings (leave ETHEREAL_USER and ETHEREAL_PASS blank to auto-generate test account on startup)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=
EMAIL_FROM="Email Scheduler <no-reply@scheduler.local>"

# Worker & Queue Tuning
WORKER_CONCURRENCY=5
EMAIL_RATE_LIMIT_MAX=10
EMAIL_RATE_LIMIT_DURATION=10000

# CORS & Client
FRONTEND_URL=http://localhost:5173
